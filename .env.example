# Public origin used in QR codes, invite links and emails.
APP_URL=http://localhost:3000

# SQLite file and upload folder. Defaults to ./data.
DATA_DIR=./data

# Delivery. Without these, messages go to the dev outbox at /dev/outbox.
RESEND_API_KEY=
EMAIL_FROM="InvitHub <invites@example.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
